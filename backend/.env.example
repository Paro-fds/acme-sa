# Copier ce fichier en .env et adapter les valeurs.
# Les mêmes noms servent sur le démonstrateur (variables de Render) et sur AWS (US-001).

# local (poste du développeur), demo (démonstrateur : données fictives imposées), recette, production
APP_ENV=local

# Base : vide = SQLite dans ACME_DATA_DIR. Démonstrateur : chaîne de connexion Supabase (« Session pooler »).
DATABASE_URL=postgresql://postgres.<projet>:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# false une fois déployé : le schéma vient des migrations (alembic upgrade head)
AUTO_CREATE_SCHEMA=true

# Fichiers : local (poste du développeur) ou s3 (démonstrateur : Supabase Storage par son accès S3 ; puis AWS)
STORAGE_BACKEND=local
S3_BUCKET=certificat
S3_ENDPOINT_URL=https://<projet>.storage.supabase.co/storage/v1/s3

S3_REGION=us-west-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Source de référence des employés (lecture seule)
ACME_CSV_PATH=../data/vault-employee-list_20261001-1400.csv

# Base SQLite et documents : dossier HORS OneDrive
ACME_DATA_DIR=C:/acme-data

# Facultatif (US-23) : les administrateurs sont enregistrés dans la base ; le premier est demandé
# par run.ps1. Ces deux lignes ne servent qu'à importer un ancien compte (base sans administrateur).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

EMPLOYEE_SESSION_MINUTES=15
ADMIN_SESSION_MINUTES=15

# US-112 : double authentification de l'espace de gestion (US-102). false = connexion directe (par défaut)
ADMIN_MFA_REQUIRED=false
MAX_UPLOAD_MB=5
MAX_DOCUMENTS_PER_EMPLOYEE=10

# V2 — parcours professionnel : éléments au plus par rubrique, fenêtre « ces derniers jours » (jours)
MAX_CAREER_ENTRIES_PER_KIND=30
CAREER_RECENT_DAYS=7
