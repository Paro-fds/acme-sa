# Copier vers un fichier non versionné (pam_export.env) et renseigner le bucket.
# L'environnement du processus l'emporte sur ce fichier.
# Ne pas y mettre de clé d'accès : utiliser le profil AWS ou le rôle de la machine.

# Dossier où la paie dépose, en fin de mois, les deux rapports Shivam
# Employee_PER_Accounts et Emp_Salary__Pay_HeadDetails.
PAM_SHARE_DIR=\\\\serveur\\shivam\\paie

# Bucket de production des balances. PAM n'y a que la lecture de per/ et payslip/.
PAM_S3_BUCKET=acme-pam-balances
PAM_S3_PREFIX=pam/balances
PAM_S3_REGION=us-east-1
# AES256, aws:kms, ou none si le bucket chiffre déjà tout seul.
PAM_S3_SSE=AES256
